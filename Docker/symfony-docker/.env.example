# Configuración del ENTORNO Docker (no confundir con src/.env, que es la de Symfony)
# Copia este fichero como ".env". Después: docker compose up -d --build

# Symfony 8.x necesita PHP 8.4; Symfony 7.4 LTS funciona desde PHP 8.2
PHP_VERSION=8.4
POSTGRES_VERSION=17

WEB_PORT=8120
ADMINER_PORT=8121
MAIL_PORT=8029
DB_PORT_HOST=5433

DB_NAME=app
DB_USER=app
DB_PASSWORD=app

XDEBUG_MODE=debug,develop

# Solo Linux/WSL: tu UID/GID (comando "id")
UID=1000
GID=1000
