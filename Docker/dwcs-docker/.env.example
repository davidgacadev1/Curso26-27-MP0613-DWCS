# =============================================================================
#  Configuración del entorno. Copia este fichero como ".env" y cambia lo que
#  necesites. Después: docker compose up -d --build
# =============================================================================

# Versión de PHP de la imagen (8.2 es la del XAMPP del aula; prueba 8.3 u 8.4)
PHP_VERSION=8.2
MARIADB_VERSION=11.4

# Puertos de TU equipo. Si XAMPP está usando el 80 y el 3306/3307, estos no chocan.
WEB_PORT=8080
PMA_PORT=8081
MAIL_PORT=8025
DB_PORT_HOST=3308

# Base de datos que se crea la primera vez (y su usuario)
DB_NAME=dwcs
DB_USER=dwcs
DB_PASSWORD=dwcs
DB_ROOT_PASSWORD=root

# Xdebug: debug,develop (depurar + avisos mejorados) | off (más rápido) | profile
XDEBUG_MODE=debug,develop

# Solo en Linux/WSL: tu usuario y grupo (comando "id") para que los ficheros
# que cree Apache sean tuyos. En Windows no hace falta tocarlo.
UID=1000
GID=1000
