{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                { "slug": "baio-mar",   "color": "#0b5c8a", "name": "Azul mar" },
                { "slug": "baio-arena", "color": "#f7f3ea", "name": "Arena" },
                { "slug": "baio-pulpo", "color": "#b5452f", "name": "Pimentón" }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--baio-arena)",
            "text": "#1d2b36"
        },
        "elements": {
            "link": {
                "color": { "text": "var(--wp--preset--color--baio-mar)" }
            },
            "heading": {
                "color": { "text": "var(--wp--preset--color--baio-pulpo)" }
            }
        }
    }
}
