# Copia este fichero como ".env". Después: docker compose up -d --build
MARIADB_VERSION=11.4

# Puertos de tu equipo (distintos de los del entorno base para poder tener ambos)
WEB_PORT=8090
PMA_PORT=8091
MAIL_PORT=8026
DB_PORT_HOST=3309

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# URL y administrador que usa scripts/instalar.sh
WP_URL=http://localhost:8090
WP_ADMIN=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@bkprogramacion.test

# Xdebug: debug,develop | off
XDEBUG_MODE=debug,develop

# Solo Linux/WSL: tu UID/GID (comando "id")
UID=1000
GID=1000
