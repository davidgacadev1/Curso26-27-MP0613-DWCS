# Copia este fichero como ".env". Después: docker compose up -d --build

# Rama de Moodle que clona scripts/obtener-moodle (MOODLE_503_STABLE = 5.3 LTS)
MOODLE_BRANCH=MOODLE_503_STABLE

# Moodle 5.1 o posterior: el código web está en moodle/public
MOODLE_DOCROOT=/var/www/moodle/public
MOODLE_PUBLIC=/var/www/moodle/public
# Moodle 5.0 (sin carpeta public): descomenta estas dos líneas y usa PHP_VERSION=8.2
# MOODLE_DOCROOT=/var/www/moodle
# MOODLE_PUBLIC=/var/www/moodle

# Moodle 5.2 y 5.3 piden PHP 8.3 o 8.4
PHP_VERSION=8.3
MARIADB_VERSION=11.4

MOODLE_URL=http://localhost:8100
MOODLE_ADMIN_PASSWORD=Admin.1234
WEB_PORT=8100
PMA_PORT=8101
MAIL_PORT=8027
DB_PORT_HOST=3310

DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=moodle
DB_ROOT_PASSWORD=root

# Xdebug: debug | debug,develop | off  (Moodle va bastante más rápido con off)
XDEBUG_MODE=debug

# Solo Linux/WSL: tu UID/GID (comando "id")
UID=1000
GID=1000
