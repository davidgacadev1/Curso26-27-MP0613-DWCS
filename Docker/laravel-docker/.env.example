# Configuración del ENTORNO Docker (no confundir con src/.env, que es la de Laravel)
# Copia este fichero como ".env". Después: docker compose up -d --build
PHP_VERSION=8.4
MARIADB_VERSION=11.4

WEB_PORT=8110
VITE_PORT=5173
PMA_PORT=8111
MAIL_PORT=8028
DB_PORT_HOST=3311

DB_NAME=laravel
DB_USER=laravel
DB_PASSWORD=laravel
DB_ROOT_PASSWORD=root

XDEBUG_MODE=debug,develop

# Solo Linux/WSL: tu UID/GID (comando "id")
UID=1000
GID=1000
